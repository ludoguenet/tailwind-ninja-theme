{
  "name": "tailwind-dark",
  "colors": {
    "activityBar.background": "#1f2937",
    "activityBar.foreground": "#f9fafb",
    "activityBarBadge.background": "#3b82f6",
    "activityBarBadge.foreground": "#ffffff",
    "sideBar.background": "#1f2937",
    "sideBar.foreground": "#f3f4f6",
    "sideBarTitle.foreground": "#f9fafb",
    "sideBarSectionHeader.background": "#1f2937",
    "sideBarSectionHeader.foreground": "#f3f4f6",
    "tab.activeBackground": "#111827",
    "tab.activeForeground": "#f9fafb",
    "tab.inactiveBackground": "#1f2937",
    "tab.inactiveForeground": "#9ca3af",
    "tab.border": "#374151",
    "editorGroupHeader.tabsBackground": "#1f2937",
    "editorGroup.border": "#374151",
    "statusBar.background": "#1f2937",
    "statusBar.foreground": "#f3f4f6",
    "titleBar.activeBackground": "#1f2937",
    "titleBar.activeForeground": "#f9fafb",
    "titleBar.inactiveBackground": "#1f2937",
    "titleBar.inactiveForeground": "#9ca3af",
    "panel.background": "#1f2937",
    "panel.border": "#374151",
    "foreground": "#f9fafb",
    "editor.background": "#111827",
    "editor.foreground": "#f9fafb",
    "editor.lineHighlightBackground": "#1f2937",
    "editor.selectionBackground": "#3b82f680",
    "editor.selectionHighlightBackground": "#3b82f640",
    "editorCursor.foreground": "#f9fafb",
    "editorWhitespace.foreground": "#374151",
    "editorIndentGuide.background": "#374151",
    "editorRuler.foreground": "#374151",
    "editorBracketMatch.background": "#3b82f633",
    "editorBracketMatch.border": "#3b82f6",
    "editorGutter.addedBackground": "#34d399",
    "editorGutter.deletedBackground": "#fb7185",
    "editorGutter.modifiedBackground": "#60a5fa",
    "diffEditor.insertedLineBackground": "#34d39940",
    "diffEditor.insertedTextBackground": "#34d39940",
    "diffEditor.removedTextBackground": "#fb718540",
    "diffEditor.removedLineBackground": "#fb718540",
    "terminal.background": "#111827",
    "terminal.foreground": "#f3f4f6",
    "terminalCommandDecoration.successBackground": "#34d39940",
    "terminalCommandDecoration.errorBackground": "#fb718540",
    "terminal.ansiBlack": "#ffffff",
    "terminal.ansiBrightBlack": "#94a3b8",
    "terminal.ansiWhite": "#cbd5e1",
    "terminal.ansiBrightWhite": "#ffffff",
    "terminal.ansiBlue": "#3b82f6",
    "terminal.ansiBrightBlue": "#60a5fa",
    "terminal.ansiCyan": "#22d3ee",
    "terminal.ansiBrightCyan": "#67e8f9",
    "terminal.ansiGreen": "#34d399",
    "terminal.ansiBrightGreen": "#6ee7b7",
    "terminal.ansiMagenta": "#c084fc",
    "terminal.ansiBrightMagenta": "#d8b4fe",
    "terminal.ansiRed": "#fb7185",
    "terminal.ansiBrightRed": "#fb7185",
    "terminal.ansiYellow": "#fbbf24",
    "terminal.ansiBrightYellow": "#fcd34d"
  },
  "tokenColors": [
    {
      "name": "PHP Static Class References",
      "scope": [
        "support.class.php",
        "support.other.namespace.php",
        "meta.function-call.static.php support.class"
      ],
      "settings": {
        "foreground": "#38bdf8"
      }
    },
    {
      "name": "PHP Keywords",
      "scope": [
        "keyword.control.php",
        "keyword.operator.class.php",
        "storage.type.php"
      ],
      "settings": {
        "foreground": "#818cf8"
      }
    },
    {
      "name": "PHP Variables",
      "scope": [
        "variable.other.php",
        "punctuation.definition.variable.php"
      ],
      "settings": {
        "foreground": "#60a5fa"
      }
    },
    {
      "name": "PHP Functions",
      "scope": [
        "entity.name.function.php",
        "support.function.php"
      ],
      "settings": {
        "foreground": "#2dd4bf"
      }
    },
    {
      "name": "PHP Methods / Object Access",
      "scope": [
        "meta.function-call.php",
        "meta.method-call.php",
        "meta.function-call.object.php"
      ],
      "settings": {
        "foreground": "#2dd4bf"
      }
    },
    {
      "name": "PHP Constants / Magic",
      "scope": [
        "constant.language.php",
        "constant.other.php",
        "support.constant.core.php",
        "support.constant.std.php"
      ],
      "settings": {
        "foreground": "#fbbf24"
      }
    },
    {
      "name": "PHP Namespace / Class",
      "scope": [
        "entity.name.type.class.php",
        "entity.other.inherited-class.php",
        "meta.namespace.php"
      ],
      "settings": {
        "foreground": "#38bdf8"
      }
    },
    {
      "name": "Vue Directives",
      "scope": [
        "entity.other.attribute-name.vue",
        "entity.other.attribute-name.html.vue",
        "meta.directive.vue",
        "meta.directive.shorthand.vue"
      ],
      "settings": {
        "foreground": "#a78bfa"
      }
    },
    {
      "name": "Vue Mustache Expressions",
      "scope": [
        "punctuation.definition.template-expression.begin.vue",
        "punctuation.definition.template-expression.end.vue"
      ],
      "settings": {
        "foreground": "#818cf8"
      }
    },
    {
      "name": "Vue Template JS",
      "scope": [
        "expression.embedded.vue"
      ],
      "settings": {
        "foreground": "#2dd4bf"
      }
    },
    {
      "name": "Vue Script Setup Imports",
      "scope": [
        "meta.import.vue",
        "meta.export.vue"
      ],
      "settings": {
        "foreground": "#818cf8"
      }
    },
    {
      "name": "Vue Refs / Reactive",
      "scope": [
        "support.variable.ref.vue",
        "support.variable.reactive.vue"
      ],
      "settings": {
        "foreground": "#38bdf8"
      }
    },
    {
      "name": "JS/TS Static Class References",
      "scope": [
        "support.class.builtin",
        "support.type",
        "variable.other.class",
        "entity.name.type.class"
      ],
      "settings": {
        "foreground": "#38bdf8"
      }
    },
    {
      "name": "JS/TS Keywords",
      "scope": [
        "keyword.control",
        "keyword.operator",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#818cf8"
      }
    },
    {
      "name": "JS/TS Variables",
      "scope": [
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#60a5fa"
      }
    },
    {
      "name": "JS/TS Constants",
      "scope": [
        "variable.other.constant",
        "constant.language",
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#fbbf24"
      }
    },
    {
      "name": "JS/TS Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#2dd4bf"
      }
    },
    {
      "name": "JS/TS Properties",
      "scope": [
        "variable.other.property",
        "meta.property.object"
      ],
      "settings": {
        "foreground": "#22d3ee"
      }
    },
    {
      "name": "Comment",
      "scope": ["comment"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#9ca3af"
      }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation"],
      "settings": {
        "foreground": "#d1d5db"
      }
    },
    {
      "name": "Constant - eg. Number, Boolean, Colors",
      "scope": ["constant"],
      "settings": {
        "foreground": "#fde68a"
      }
    },
    {
      "name": "Entity - eg. Function, Type, Tag, Attribute Name",
      "scope": ["entity"],
      "settings": {
        "foreground": "#38bdf8"
      }
    },
    {
      "name": "Entity Name - eg. Function, Type, Tag, Attribute Name",
      "scope": ["entity.name"],
      "settings": {
        "foreground": "#38bdf8"
      }
    },
    {
      "name": "Entity Name Function - eg. Function, Type, Tag, Attribute Name",
      "scope": ["entity.name.function"],
      "settings": {
        "foreground": "#99f6e4"
      }
    },
    {
      "name": "Keyword - eg. Control (while, for), Operator (or)",
      "scope": ["keyword"],
      "settings": {
        "foreground": "#c4b5fd"
      }
    },
    {
      "name": "Keyword Assignment - eg. =",
      "scope": ["keyword.operator.assignment"],
      "settings": {
        "foreground": "#9ca3af"
      }
    },
    {
      "name": "Storage - eg. Type (class, function, var)",
      "scope": ["storage"],
      "settings": {
        "foreground": "#c4b5fd"
      }
    },
    {
      "name": "String - eg. Quoted Value, Interpolated Values, Regex",
      "scope": ["string", "punctuation.definition.string"],
      "settings": {
        "foreground": "#818cf8"
      }
    },
    {
      "name": "Support - eg. Key in JSON",
      "scope": ["support"],
      "settings": {
        "foreground": "#38bdf8"
      }
    },
    {
      "name": "Variable - eg. Named Import, Variable",
      "scope": ["variable"],
      "settings": {
        "foreground": "#3b82f6"
      }
    },
    {
      "name": "Variable Object - eg. Named Import, Variable",
      "scope": ["variable.other.constant.object"],
      "settings": {
        "foreground": "#3b82f6"
      }
    },
    {
      "name": "[HTML] - Entity",
      "scope": ["text.html entity"],
      "settings": {
        "foreground": "#38bdf8"
      }
    },
    {
      "name": "[HTML] - Attribute Names",
      "scope": ["text.html entity.other.attribute-name"],
      "settings": {
        "foreground": "#22d3ee"
      }
    },
    {
      "name": "[HTML] - Attribute Values",
      "scope": ["text.html string.quoted", "text.html punctuation.definition.string"],
      "settings": {
        "foreground": "#818cf8"
      }
    },
    {
      "name": "[HTML] - Punctation",
      "scope": ["text.html punctuation", "text.html keyword.operator", "text.html meta.tag"],
      "settings": {
        "foreground": "#d1d5db"
      }
    },
    {
      "name": "[HTML] - Doctype",
      "scope": ["text.html meta.tag.sgml", "text.html meta.tag.sgml punctuation"],
      "settings": {
        "foreground": "#94a3b8"
      }
    },
    {
      "name": "[HTML] - Function",
      "scope": ["text.html entity.name.function"],
      "settings": {
        "foreground": "#99f6e4"
      }
    },
    {
      "name": "[CSS] - Entity - eg. .class, #id, body, :root",
      "scope": [
        "source.css entity",
        "source.css entity.other.attribute-name.class",
        "source.css entity.other.attribute-name.id",
        "source.css entity.other.attribute-name.pseudo-class",
        "source.css punctuation.definition.entity"
      ],
      "settings": {
        "foreground": "#38bdf8"
      }
    },
    {
      "name": "[CSS] - Meta Attribute - eg. [data-attribute]",
      "scope": [
        "source.css meta.attribute-selector",
        "source.css meta.attribute-selector punctuation.definition.string",
        "source.css entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#818cf8"
      }
    },
    {
      "name": "[CSS] - @ - eg. @media",
      "scope": ["source.css keyword.control.at-rule", "source.css punctuation.definition.keyword"],
      "settings": {
        "foreground": "#0ea5e9"
      }
    },
    {
      "name": "[CSS] - Meta Value - eg. value",
      "scope": [
        "source.css meta.property-value",
        "source.css meta.property-value.css punctuation.definition.constant",
        "source.css meta.property-list meta.at-rule",
        "source.css variable.parameter"
      ],
      "settings": {
        "foreground": "#cbd5e1"
      }
    },
    {
      "name": "[CSS] - Constant - eg. 2.55, ease-out",
      "scope": ["source.css constant", "source.css support.constant"],
      "settings": {
        "foreground": "#cbd5e1"
      }
    },
    {
      "name": "[CSS] - Meta Name - eg. font-family, 'name'",
      "scope": ["source.css meta.property-name", "source.css support.type.property-name", "source.css string"],
      "settings": {
        "foreground": "#818cf8"
      }
    },
    {
      "name": "[CSS] - Function - eg. var(), rgba()",
      "scope": ["source.css support.function"],
      "settings": {
        "foreground": "#60a5fa"
      }
    },
    {
      "name": "[CSS] - Keyword - eg. =, and",
      "scope": ["source.css keyword.control", "source.css keyword.operator"],
      "settings": {
        "foreground": "#d1d5db"
      }
    },
    {
      "name": "[CSS] - Unit - eg. px, %",
      "scope": ["source.css keyword.other.unit"],
      "settings": {
        "foreground": "#ccfbf1"
      }
    },
    {
      "name": "[CSS] - Variable - eg. --var",
      "scope": [
        "source.css variable",
        "source.css entity.other.attribute-name.placeholder",
        "source.css entity.other.attribute-name.placeholder punctuation.definition.entity"
      ],
      "settings": {
        "foreground": "#99f6e4"
      }
    },
    {
      "name": "[CSS] - Punctuation - eg. <> , . () []",
      "scope": [
        "source.css punctuation.section",
        "source.css punctuation.separator",
        "source.css punctuation.terminator",
        "source.css punctuation.definition.constant",
        "source.css meta.attribute-selector punctuation.definition",
        "source.css punctuation.definition.parameters",
        "source.css punctuation.access",
        "source.css meta.property-list"
      ],
      "settings": {
        "foreground": "#d1d5db"
      }
    },
    {
      "name": "[HTML in JS] - Entity",
      "scope": [
        "source.js meta.block entity.name.tag",
        "source.ts meta.block entity.name.tag",
        "source.tsx meta.block entity.name.tag"
      ],
      "settings": {
        "foreground": "#38bdf8"
      }
    },
    {
      "name": "[HTML in JS] - Attribute Names",
      "scope": [
        "source.js meta.block entity.other.attribute-name",
        "source.ts meta.block entity.other.attribute-name",
        "source.tsx meta.block entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#22d3ee"
      }
    },
    {
      "name": "[HTML in JS] - Attribute Values",
      "scope": [
        "source.js meta.block string.quoted",
        "source.ts meta.block string.quoted",
        "source.tsx meta.block string.quoted",
        "source.js meta.block punctuation.definition.string",
        "source.ts meta.block punctuation.definition.string",
        "source.tsx meta.block punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#818cf8"
      }
    },
    {
      "name": "[HTML in JS] - Constant",
      "scope": [
        "source.js meta.block meta.jsx.children",
        "source.ts meta.block meta.jsx.children",
        "source.tsx meta.block meta.jsx.children"
      ],
      "settings": {
        "foreground": "#cbd5e1"
      }
    },
    {
      "name": "[HTML in JS] - Expression",
      "scope": [
        "source.js meta.block meta.embedded.expression variable.other",
        "source.ts meta.block meta.embedded.expression variable.other",
        "source.tsx meta.block meta.embedded.expression variable.other",
        "source.js meta.block meta.embedded.expression variable.other.readwrite",
        "source.ts meta.block meta.embedded.expression variable.other.readwrite",
        "source.tsx meta.block meta.embedded.expression variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#c084fc"
      }
    },
    {
      "name": "[HTML in JS] - Expression Ternary",
      "scope": [
        "source.js meta.block keyword.operator.ternary",
        "source.ts meta.block keyword.operator.ternary",
        "source.tsx meta.block keyword.operator.ternary"
      ],
      "settings": {
        "foreground": "#a78bfa"
      }
    },
    {
      "name": "[JSON] - Support",
      "scope": ["source.json support"],
      "settings": {
        "foreground": "#cbd5e1"
      }
    },
    {
      "name": "[JSON] - Constant",
      "scope": ["source.json constant"],
      "settings": {
        "foreground": "#fb7185"
      }
    },
    {
      "name": "[JSON] - Constant (Escaped) - eg. '",
      "scope": ["constant.character.escape"],
      "settings": {
        "foreground": "#cbd5e1"
      }
    },
    {
      "name": "[JS] - Variable",
      "scope": ["variable.other.property.js"],
      "settings": {
        "foreground": "#cbd5e1"
      }
    },
    {
      "name": "[JS] - Import",
      "scope": ["meta.import keyword.control.import"],
      "settings": {
        "foreground": "#0ea5e9"
      }
    },
    {
      "name": "[JS] - Import From",
      "scope": ["meta.import keyword.control.from", "meta.import punctuation"],
      "settings": {
        "foreground": "#d1d5db"
      }
    },
    {
      "name": "[JS] - Import String - eg. '../location/file",
      "scope": ["meta.import string", "meta.import string punctuation.definition.string"],
      "settings": {
        "foreground": "#64748b"
      }
    },
    {
      "name": "[JS] - Import Variable - eg. React, Moment",
      "scope": ["meta.import variable.other.readwrite"],
      "settings": {
        "foreground": "#0ea5e9"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#60a5fa",
    "parameter": "#38bdf8",
    "property": "#22d3ee",
    "function": "#2dd4bf",
    "method": "#2dd4bf",
    "keyword": "#818cf8",
    "class": "#38bdf8",
    "enumMember": "#fbbf24",
    "string": "#818cf8",
    "number": "#fb923c",
    "comment": "#9ca3af"
  },
  "semanticHighlighting": true
}
